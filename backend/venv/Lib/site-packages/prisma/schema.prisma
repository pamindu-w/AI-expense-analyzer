generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 3
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id         Int      @id @default(autoincrement())
  title      String
  amount     Float
  category   String
  created_at DateTime @default(now())
}

model User {
  id              Int      @id @default(autoincrement())
  username        String   @unique
  email           String   @unique
  hashed_password String
  created_at      DateTime @default(now())
}
