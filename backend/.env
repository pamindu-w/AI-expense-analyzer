# ─── Local Development ───────────────────────────────────────────────────────
# SQLite (no setup required — default for local dev):
DATABASE_URL=sqlite:///./spendwise.db

# PostgreSQL (uncomment and fill in when using Postgres):
# DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/expense_analyzer

# JWT secret key — CHANGE THIS in production!
SECRET_KEY=changeme-super-secret-key-use-a-long-random-string
