generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Expense {
  id         Int      @id @default(autoincrement())
  title      String
  amount     Float
  category   String
  created_at DateTime @default(now())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  category   String?
  month      String?
  amount     Float?
  signature  String
  read       Boolean  @default(false)
  created_at DateTime @default(now())

  @@unique([user_id, signature])
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  hashed_password String
  created_at      DateTime  @default(now())
  expenses        Expense[]
  budgets         Budget[]
  recurring_expenses  RecurringExpense[]
  notifications   Notification[]
  chat_messages   ChatMessage[]
  digests         Digest[]
}

model Budget {
  id         Int      @id @default(autoincrement())
  category   String
  limit      Float
  month      String
  created_at DateTime @default(now())

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category, month])
}

model RecurringExpense {
  id          Int      @id @default(autoincrement())
  title       String
  amount      Float
  category    String
  frequency   String
  next_run    DateTime
  active      Boolean  @default(true)
  deactivated_at DateTime?
  deleted_at  DateTime?
  created_at  DateTime @default(now())

  user_id Int
  user    User @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Digest {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  period_key String
  content    String
  created_at DateTime @default(now())

  @@unique([user_id, period_key])
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  user_id    Int
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       String
  content    String
  created_at DateTime @default(now())

  @@index([user_id, created_at])
}